gameMSG1 BYTE "  *     * *   * *   *   *   *     *     *     * *   * *     *     ", 0
gameMSG2 BYTE "  ******* ***** *****   *   *     *     ******* *   * *     *     ", 0
gameMSG3 BYTE "  *   *   *   * *       *   *     *     *   *   *   * *     *     ", 0
gameMSG4 BYTE "  *    *  *   * *     ***** *****       *    *  ***** ***** ***** ", 0
