; Include Irvine32 library (console helpers, RandomRange, etc.)
Include Irvine32.inc
; Define entry point label for the linker
main	EQU start@0

; Configuration constants
; size of the cube drawn (1 cell)
cubeSize = 1
; length of each platform line in characters
lineSize = 12
; right border X coordinate (max X)
borderX = 119    
; bottom border Y coordinate (max Y)
borderY = 30

.data
;==============================================================================;
;                                  For Menu /Start                             ;
;==============================================================================;
